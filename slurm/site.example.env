# Site file: copy to slurm/site.<name>.env, fill in, and pass --site <name> to submit.sh, budget.py, fleet_dispatch.sh and
# fleet_status.sh. Sourced by bash (keep it valid shell) and parsed by budget.py (KEY=VALUE per line; text after # is ignored).
# Every key is described in docs/configuration.md.

ACCOUNT="your-slurm-account"     # the project account every fleet job is charged to (sbatch --account)
PARTITION="gpu"                  # the GPU partition fleet jobs run in
DEVEL_PARTITION="gpu"            # used by submit.sh --devel (short test jobs)
GPUS_PER_NODE=4                  # GPUs on one node; every job asks for the whole node (the packing rule)
CPUS_PER_NODE=288                # cores asked for per node (all of them on whole-node sites)
MAX_TIME="11:30:00"              # default --time; keep it under the QoS maximum wall time, with room for the checkpoint warning
DEVEL_MAX_TIME="00:30:00"        # default --time for --devel
SIGNAL_BEFORE_END=900            # seconds before the limit at which Slurm sends USR1 (the checkpoint warning)
ENV_ACTIVATE=':'                 # evaluated in the batch script before the launcher starts, e.g. 'source /path/to/env/activate.sh'
PACK_EXTRA="--numa --sample 30 --cpu-sample 30 --gpu-cores 8 --sidecar-nice 10 --idle-gpu-minutes 45 --idle-gpu-util 1"
CPU_PARTITION=""                 # a CPU partition for --cpu-only specs; empty = CPU work rides as sidecars on GPU nodes
BUDGET_SINCE="2026-01-01"        # start of the allocation period: the budget check and the ledger count accounting from here
CHARGE_WHOLE_NODES=1             # 1 = a job is charged for every GPU of its nodes even if its steps hold none (whole-node sites)
MAX_NODES_IN_FLIGHT=5            # the fleet ceiling: nodes of the account in flight at once; beyond it jobs are queued held
REVIEW_THRESHOLD_HOURS=50        # a worst case above this many GPU-hours is submitted held for a human's review (0 = never)
NO_DUPLICATE_NAMES=1             # refuse a job whose name is already pending or running (--allow-same-name overrides)
MAX_SUBMITS_PER_10MIN=12         # the rate guard: refuse when the account has submitted this many jobs inside ten minutes

# The fleet queue, its lock and the release log. They default to receipts/ beside this tooling; set absolute paths on a shared
# file system when several copies of the tooling are in use, so every copy queues and releases from one list.
# FLEET_QUEUE_FILE="${FLEET_QUEUE_FILE:-/shared/path/fleet/receipts/FLEET_QUEUE.log}"
# FLEET_LOCK_DIR="${FLEET_LOCK_DIR:-/shared/path/fleet/receipts/.fleet.lock}"
# FLEET_DISPATCH_LOG="${FLEET_DISPATCH_LOG:-/shared/path/fleet/receipts/FLEET_DISPATCH.log}"
# FLEET_RESERVATIONS_FILE="${FLEET_RESERVATIONS_FILE:-/shared/path/fleet/receipts/FLEET_RESERVATIONS.log}"   # accepted jobs' worst cases until the queue or accounting shows them
# FLEET_SUBMISSIONS_FILE="${FLEET_SUBMISSIONS_FILE:-/shared/path/fleet/receipts/FLEET_SUBMISSIONS.log}"   # one line per submission, never pruned: the rate guard's window and wait_jobs.py's array element sets
