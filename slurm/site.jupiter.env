# JUPITER Booster (Jülich Supercomputing Centre): the settings of the original deployment, with the account left for you to fill in.
# Nodes: four NVIDIA GH200 superchips each (four Hopper GPUs, four 72-core Grace CPUs, 288 cores), charged whole.
# Facts that shaped them: a 12-hour maximum wall time on the normal QoS; no CPU partition on the Booster; $SCRATCH is purged after
# 30 days of inactivity; compute nodes have no internet. Check the current JSC documentation before relying on any of these.
ACCOUNT="your-project-account"
PARTITION="booster"
DEVEL_PARTITION="booster"        # no separate development partition: --devel is a 30-minute job on booster
GPUS_PER_NODE=4
CPUS_PER_NODE=288
MAX_TIME="11:30:00"              # under the 12:00:00 QoS limit: jobs checkpoint on USR1 and resume in the next segment
DEVEL_MAX_TIME="00:30:00"
SIGNAL_BEFORE_END=900
ENV_ACTIVATE=':'                 # e.g. 'source $PROJECT/env/activate.sh' (modules + a venv on the shared file system)
PACK_EXTRA="--numa --sample 30 --cpu-sample 30 --gpu-cores 8 --sidecar-nice 10 --idle-gpu-minutes 45 --idle-gpu-util 1"   # 8 of 72 cores per GPU task on its own Grace, the rest for sidecars at nice 10; the GPU-idle watchdog
CPU_PARTITION=""                 # none on the Booster: CPU work rides as sidecars, or --force-node holds a whole node
BUDGET_SINCE="2026-01-01"
CHARGE_WHOLE_NODES=1
MAX_NODES_IN_FLIGHT=5            # Slurm did not enforce a node limit on the original project account; this wrapper does
REVIEW_THRESHOLD_HOURS=50
NO_DUPLICATE_NAMES=1
MAX_SUBMITS_PER_10MIN=12
# Budget unit on JSC systems: `jutil project cpuquota` reports core-hours; on the Booster 72 core-hours = 1 GPU-hour.
