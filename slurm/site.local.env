# A workstation or a one-node test cluster as a stand-in (here: two GPUs, 24 cores): same job shapes, smaller node.
ACCOUNT="fleet"
PARTITION="gpu"
DEVEL_PARTITION="gpu"
GPUS_PER_NODE=2
CPUS_PER_NODE=18                 # GPU jobs take 18 of 24 cores so CPU-only jobs (up to 6 cores) can run beside them
MAX_TIME="23:30:00"
DEVEL_MAX_TIME="00:30:00"
SIGNAL_BEFORE_END=300
ENV_ACTIVATE=':'
PACK_EXTRA="--sample 30"
CPU_PARTITION="gpu"              # the stand-in shares its one node; CPU-only jobs take cores, no gres, no GPU charge
BUDGET_SINCE="2026-01-01"
CHARGE_WHOLE_NODES=0
REVIEW_THRESHOLD_HOURS=0         # 0 = no automatic hold on the stand-in
