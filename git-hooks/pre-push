#!/bin/bash
# Fleet size guard on push: refuse a push whose new commits introduce a blob above the limit, whichever
# machine made the commit. Limit: FLEET_MAX_FILE_MB (default 10). Deliberate exception, once: FLEET_ALLOW_LARGE=1 git push ...
LIMIT_MB=${FLEET_MAX_FILE_MB:-10}; LIMIT=$((LIMIT_MB*1024*1024))
[ "${FLEET_ALLOW_LARGE:-0}" = 1 ] && exit 0
z40=0000000000000000000000000000000000000000; bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  while read -r sha size path; do
    printf 'refused: %s (%d bytes, over the %d MB limit; blob %s) in the commits being pushed to %s\n' "$path" "$size" "$LIMIT_MB" "${sha:0:10}" "$remote_ref" >&2; bad=1
  done < <(git rev-list --objects $range 2>/dev/null | git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | awk -v lim="$LIMIT" '$1=="blob" && $3>lim {print $2, $3, $4}')
done
if [ $bad != 0 ]; then
  echo "Fleet pre-push hook: large files refused (limit ${LIMIT_MB} MB). Remove them from the commits (git rm --cached, amend or rebase) and keep outputs outside git. A deliberate exception: FLEET_ALLOW_LARGE=1 git push ..." >&2
  exit 1
fi
exit 0
