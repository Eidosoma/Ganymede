#!/bin/bash
# fake sbatch: records the call, adds a pending job to $FAKE/jobs.txt, prints a new id
[ -e "$FAKE/sbatch_fail" ] && { echo "sbatch: error: Batch job submission failed: Socket timed out" >&2; exit 1; }
echo "$*" >> "$FAKE/sbatch_calls.txt"
N=$(( $(cat "$FAKE/next_id" 2>/dev/null || echo 5000) + 1 )); echo $N > "$FAKE/next_id"
name=job; nodes=1; dep='(null)'; reason=None; lim='1:00:00'
for a in "$@"; do case "$a" in --job-name=*) name="${a#*=}";; --nodes=*) nodes="${a#*=}";; --dependency=*) dep="${a#*=}(unfulfilled)"; reason=Dependency;; --hold) reason=JobHeldUser;; --time=*) lim="${a#*=}";; esac; done
echo "$N|$N|$nodes|PD|$dep|$reason|$(date +%FT%T)|$name|$lim|0:00" >> "$FAKE/jobs.txt"
echo "$N"
