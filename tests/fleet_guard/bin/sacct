#!/bin/bash
echo "$*" >> "$FAKE/sacct_calls.txt"
case " $* " in *" --format=JobID,JobName,Partition,State,ElapsedRaw,AllocTRES "*)   # the status screens' read (fleet_status.sh, jobs.sh):
  [ -e "$FAKE/sacct_fail" ] && exit 1; [ -f "$FAKE/sacct.status.txt" ] && cat "$FAKE/sacct.status.txt"; exit 0;; esac   # its own answer, outside the numbered calls
n=$(( $(cat "$FAKE/sacct_n" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$FAKE/sacct_n"   # call n can have its own answer: sacct.<n>.txt, sacct.<n>.rc
if [ -f "$FAKE/sacct.$n.txt" ]; then cat "$FAKE/sacct.$n.txt"; exit "$(cat "$FAKE/sacct.$n.rc" 2>/dev/null || echo 0)"; fi
if [ -e "$FAKE/sacct_slow" ]; then s=$(cat "$FAKE/sacct_slow"); rm -f "$FAKE/sacct_slow"; sleep "$s"; fi   # one slow answer
[ -e "$FAKE/sacct_fail" ] && exit 1
[ -f "$FAKE/sacct.txt" ] && cat "$FAKE/sacct.txt"
exit 0
