#!/bin/bash
echo "$*" >> "$FAKE/scontrol_calls.txt"
[ -e "$FAKE/scontrol_fail" ] && { echo "scontrol: error: Unable to contact slurm controller (connect failure)" >&2; exit 1; }   # tests: a failed call
if [ "$1" = release ]; then awk -F'|' -v OFS='|' -v j="$2" '$2==j && $6=="JobHeldUser"{$6=(($5=="(null)" || $5=="") ? "None" : "Dependency")} {print}' "$FAKE/jobs.txt" > "$FAKE/jobs.tmp" && mv "$FAKE/jobs.tmp" "$FAKE/jobs.txt"; fi
exit 0
