# The test site for tests/fleet_guard/run_tests.sh: a four-node fleet with a review threshold of 50 GPU-hours. Never a real site.
ACCOUNT="test-account"
PARTITION="gpu"
DEVEL_PARTITION="gpu"
GPUS_PER_NODE=4
CPUS_PER_NODE=288
MAX_TIME="11:30:00"
DEVEL_MAX_TIME="00:30:00"
SIGNAL_BEFORE_END=900
ENV_ACTIVATE=':'
PACK_EXTRA="--numa --sample 30 --cpu-sample 30 --gpu-cores 8 --sidecar-nice 10 --idle-gpu-minutes 45 --idle-gpu-util 1"
CPU_PARTITION=""
BUDGET_SINCE="2026-01-01"
CHARGE_WHOLE_NODES=1
MAX_NODES_IN_FLIGHT=4
REVIEW_THRESHOLD_HOURS=50
NO_DUPLICATE_NAMES=1
MAX_SUBMITS_PER_10MIN=12
FLEET_QUEUE_FILE="${FLEET_QUEUE_FILE:-/nonexistent/ganymede-test/FLEET_QUEUE.log}"
FLEET_LOCK_DIR="${FLEET_LOCK_DIR:-/nonexistent/ganymede-test/.fleet.lock}"
FLEET_DISPATCH_LOG="${FLEET_DISPATCH_LOG:-/nonexistent/ganymede-test/FLEET_DISPATCH.log}"
FLEET_RESERVATIONS_FILE="${FLEET_RESERVATIONS_FILE:-/nonexistent/ganymede-test/FLEET_RESERVATIONS.log}"
FLEET_SUBMISSIONS_FILE="${FLEET_SUBMISSIONS_FILE:-/nonexistent/ganymede-test/FLEET_SUBMISSIONS.log}"
